{
  "name": "dsh-lite",
  "version": "1.0.0",
  "description": "DSH DLE — DeepSeek Harness Desktop Lite Edition: thin Electron shell (tray + notifications + security) sharing the dev ~/.dsh profile",
  "main": "main.js",
  "author": "DSH DLE",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.deepseek.dshlite",
    "productName": "DSH DLE",
    "artifactName": "DSH-DLE-Setup-${version}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "main.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "DSH DLE",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
